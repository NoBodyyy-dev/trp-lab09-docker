@page
@model VariantModel
@{
    ViewData["Title"] = "Расчёт варианта";
}
<h1>Расчёт номера варианта</h1>

<form class="card" method="post">
    <div class="filters">
        <div class="field">
            <label asp-for="StudentId">Номер зачётной книжки</label>
            <input asp-for="StudentId" type="text" inputmode="numeric" />
        </div>
        <div class="field">
            <label asp-for="Total">Количество вариантов</label>
            <input asp-for="Total" type="text" inputmode="numeric" />
        </div>
        <button class="btn btn-primary" type="submit">Рассчитать</button>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-error" style="margin-top:16px">
            <ul>
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    else if (Model.Variant is not null)
    {
        <p style="margin-top:16px">Ваш вариант: <strong>@Model.Variant</strong>
            <span class="muted">(@Model.StudentId mod @Model.Total + 1)</span>.</p>
    }
</form>
