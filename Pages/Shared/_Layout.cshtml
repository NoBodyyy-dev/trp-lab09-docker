<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ЛР7 Razor Pages</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <div class="bar">
        <a class="brand" asp-page="/Index">Справочник предсказаний · Razor Pages</a>
        <nav>
            <a asp-page="/Index">Гороскоп</a>
            <a asp-page="/Predictions/Index">Предсказания</a>
            <a asp-page="/Predictions/Create">Добавить</a>
            <a asp-page="/Predictions/Random">Случайное</a>
            <a asp-page="/Variant">Вариант</a>
            <a asp-page="/Hello">Приветствие</a>
        </nav>
    </div>
</header>
<main>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-ok">@message</div>
    }
    @RenderBody()
</main>
<footer>
    Лабораторная работа № 7 · @StudentInfo.Name, @StudentInfo.Group
</footer>
</body>
</html>
